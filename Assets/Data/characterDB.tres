[resource]
script = ExtResource("1_i6avy")
textures = Array[Texture2D]([ExtResource("4_bu7xg"), ExtResource("5_efky2"), SubResource("AtlasTexture_c7343")])
names = Array[String](["Princis Artorius Valenhardt Aurelius", "Sers Cedric Vaneholt Ravenshield", "Dāma Elīra Silverthorn Vaeloria"])
stories = Array[String](["Princis Artorius Valenhardt Aurelius nāk no senas karaļu dzimtas, kas gadsimtiem ilgi valdīja pār aukstu ziemeļu karalisti. Pēc nodevības karaliskajā galmā viņš zaudēja tiesības uz troni un zvērēja pats noskaidrot, kurš iznīcināja viņa ģimenes godu. Tagad Artorijs ceļo pa pasauli, palīdzot ciemiem un pilsētām, lai atgūtu uzticību vienkāršajiem ļaudīm un atrastu patiesību par savu dzimtu.", "Reiz viņš bija karaļa pavadoņu vienības karotājs, bet pēc Ziemeļu vārtu krišanas pazuda bez pēdām. Tagad viņš klīst kā kluss zobens algotņu rindās, saistīts ar senu zvērestu un parādu, ko viņš atsakās aizmirst.", "Elīra ir jauna bruņiniece, kura jau kopš bērnības sargāja savu zemi no tumsas radībām. Kad pasaule sāka grimt tumsā un gaisma pazuda, viņa devās ceļā, lai atrastu tās avotu un atjaunotu mieru. Elīra ir drosmīga, neatlaidīga un nekad neatkāpjas, pat tad, kad cerība gandrīz ir zudusi."])
idle_frames = Array[SpriteFrames]([ExtResource("1_7d18p"), ExtResource("2_bu7xg"), ExtResource("3_0trxb")])
sprite_offsets = Array[Vector2]([Vector2(0, -16), Vector2(1, -14), Vector2(0, 0)])
