script = ExtResource("1_i6avy")
textures = Array[Texture2D]([ExtResource("3_s6c3s"), ExtResource("5_bu7xg")])
names = Array[String](["Princis Artorius Valenhardt Aurelius", "Sers Cedric Vaneholt Ravenshield"])
stories = Array[String](["Princis Artorius Valenhardt Aurelius nāk no senas karaļu dzimtas, kas gadsimtiem ilgi valdīja pār aukstu ziemeļu karalisti. Pēc nodevības karaliskajā galmā viņš zaudēja tiesības uz troni un zvērēja pats noskaidrot, kurš iznīcināja viņa ģimenes godu. Tagad Artorijs ceļo pa pasauli, palīdzot ciemiem un pilsētām, lai atgūtu uzticību vienkāršajiem ļaudīm un atrastu patiesību par savu dzimtu.", "Reiz viņš bija karaļa pavadoņu vienības karotājs, bet pēc Ziemeļu vārtu krišanas pazuda bez pēdām. Tagad viņš klīst kā kluss zobens algotņu rindās, saistīts ar senu zvērestu un parādu, ko viņš atsakās aizmirst."])
idle_frames = Array[SpriteFrames]([ExtResource("1_7d18p"), ExtResource("2_bu7xg")])
