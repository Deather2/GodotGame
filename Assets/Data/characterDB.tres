[resource]
script = ExtResource("1_i6avy")
names = Array[String](["Princis Artorius Valenhardt Aurelius", "Sers Cedric Vaneholt Ravenshield", "Dāma Elīra Silverthorn Vaeloria", "Kaelens Dravemors"])
stories = Array[String](["Princis Artorius Valenhardt Aurelius nāk no senas karaļu dzimtas, kas gadsimtiem ilgi valdīja pār aukstu ziemeļu karalisti. Pēc nodevības karaliskajā galmā viņš zaudēja tiesības uz troni un zvērēja pats noskaidrot, kurš iznīcināja viņa ģimenes godu. Tagad Artorijs ceļo pa pasauli, palīdzot ciemiem un pilsētām, lai atgūtu uzticību vienkāršajiem ļaudīm un atrastu patiesību par savu dzimtu.", "Reiz viņš bija karaļa pavadoņu vienības karotājs, bet pēc Ziemeļu vārtu krišanas pazuda bez pēdām. Tagad viņš klīst kā kluss zobens algotņu rindās, saistīts ar senu zvērestu un parādu, ko viņš atsakās aizmirst.", "Elīra ir jauna bruņiniece, kura jau kopš bērnības sargāja savu zemi no tumsas radībām. Kad pasaule sāka grimt tumsā un gaisma pazuda, viņa devās ceļā, lai atrastu tās avotu un atjaunotu mieru. Elīra ir drosmīga, neatlaidīga un nekad neatkāpjas, pat tad, kad cerība gandrīz ir zudusi.", "Kaelens Dravemors ir pieredzējis karotājs, kurš jau daudzus gadus cīnās pret tumsas radībām. Viņš ir mierīgs, izturīgs un vienmēr gatavs aizsargāt tos, kuri paši to nespēj. Kopš bērnības viņš ceļoja kopā ar savu jaunāko māsu, un abi viens otram bija vienīgā īstā ģimene. Kad pasauli sāka pārņemt tumsa, Kaelens nolēma doties uz priekšu pirmais, lai atrastu veidu, kā atjaunot gaismu un pasargāt savu māsu no likteņa, kas reiz iznīcināja viņu mājas."])
idle_frames = Array[SpriteFrames]([ExtResource("1_7d18p"), ExtResource("2_bu7xg"), ExtResource("3_0trxb"), ExtResource("4_bu7xg")])
sprite_offsets = Array[Vector2]([Vector2(0, -16), Vector2(1, -14), Vector2(0, 4), Vector2(0, -17)])
